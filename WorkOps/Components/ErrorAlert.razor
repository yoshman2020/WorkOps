@using WorkOps.Models.Errors
@if (!string.IsNullOrEmpty(Message))
{
    var alertClass = ErrorCode != WorkOps.Models.Errors.ErrorCode.None
        ? "danger" : "success";
    <div class="alert alert-@alertClass" role="alert">
        @Message
    </div>
}

@code {
    [Parameter]
    public ErrorCode? ErrorCode { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public object[]? Args { get; set; }


    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Message) && ErrorCode != null
            && ErrorCode != WorkOps.Models.Errors.ErrorCode.None)
        {
            Message = ErrorMessage.GetMessage(
                ErrorCode.Value, Args ?? Array.Empty<object>());
        }
    }
}
