@page "/mworktimes/edit"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@inject ILogger<Edit> Logger
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>編集</PageTitle>

<h1>編集</h1>

<h2>勤務時間</h2>
<hr />
@if (MWorkTime is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="MWorkTime" OnValidSubmit="UpdateMWorkTime" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <ErrorAlert ErrorCode="@ErrorCode" />
                <div class="mb-3">
                    <label for="name" class="form-label">勤務時間名:</label>
                    <InputText id="name" @bind-Value="MWorkTime.Name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => MWorkTime.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="starttime" class="form-label">開始時間:</label>
                    <InputDate Type="InputDateType.Time" id="starttime" @bind-Value="MWorkTime.StartTime" class="form-control" />
                    <ValidationMessage For="() => MWorkTime.StartTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="endtime" class="form-label">終了時間:</label>
                    <InputDate Type="InputDateType.Time" id="endtime" @bind-Value="MWorkTime.EndTime" class="form-control" />
                    <ValidationMessage For="() => MWorkTime.EndTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="breakstarttime" class="form-label">休憩開始時間:</label>
                    <InputDate Type="InputDateType.Time" id="breakstarttime" @bind-Value="MWorkTime.BreakStartTime" class="form-control" />
                    <ValidationMessage For="() => MWorkTime.BreakStartTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="breakendtime" class="form-label">休憩終了時間:</label>
                    <InputDate Type="InputDateType.Time" id="breakendtime" @bind-Value="MWorkTime.BreakEndTime" class="form-control" />
                    <ValidationMessage For="() => MWorkTime.BreakEndTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="workedduration" class="form-label">勤務時間:</label>
                    <InputDate Type="InputDateType.Time" id="workedduration" @bind-Value="MWorkTime.WorkedDurationTime" class="form-control" />
                    <ValidationMessage For="() => MWorkTime.WorkedDurationTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="remarks" class="form-label">備考:</label>
                    <InputText id="remarks" @bind-Value="MWorkTime.Remarks" class="form-control" />
                    <ValidationMessage For="() => MWorkTime.Remarks" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">保存</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/mworktimes">一覧に戻る</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel? MWorkTime { get; set; }

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            if (Id == 0)
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }

            (MWorkTime, _) = await InputModelService
                .GetInputModelAsync<InputModel, MWorkTime>(Id);

            if (MWorkTime is null)
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }
            MWorkTime!.WorkedDurationTime =
                    TimeOnly.FromTimeSpan(MWorkTime!.WorkedDuration!.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateMWorkTime()
    {
        Logger.LogDebug("▽UpdateMWorkTime");
        try
        {
            MWorkTime!.WorkedDuration = MWorkTime.WorkedDurationTime.ToTimeSpan();
            ErrorCode = await InputModelService
                .SaveInputModelAsync<InputModel, MWorkTime>(MWorkTime!, Id);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogError(ex, "Exception occurred!");
            if (!MWorkTimeExists(MWorkTime!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        if (ErrorCode == WorkOps.Models.Errors.ErrorCode.None)
        {
            NavigationManager.NavigateTo("/mworktimes");
        }
        Logger.LogDebug("△UpdateMWorkTime");
    }

    private bool MWorkTimeExists(int id)
    {
        return DbContext.MWorkTime.Any(e => e.Id == id);
    }
}
