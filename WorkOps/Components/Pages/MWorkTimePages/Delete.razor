@page "/mworktimes/delete"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@inject ILogger<Delete> Logger

<PageTitle>削除</PageTitle>

<h1>削除</h1>

<p>削除します。よろしいですか？</p>
<div>
    <h2>勤務時間</h2>
    <hr />
    @if (mworktime is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">勤務時間名</dt>
            <dd class="col-sm-10">@mworktime.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">開始時間</dt>
            <dd class="col-sm-10">@mworktime.StartTime</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">終了時間</dt>
            <dd class="col-sm-10">@mworktime.EndTime</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">休憩開始時間</dt>
            <dd class="col-sm-10">@mworktime.BreakStartTime</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">休憩終了時間</dt>
            <dd class="col-sm-10">@mworktime.BreakEndTime</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">勤務時間</dt>
            <dd class="col-sm-10">@mworktime.WorkedDurationString</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">備考</dt>
            <dd class="col-sm-10">@mworktime.Remarks</dd>
        </dl>
        <EditForm method="post" Model="mworktime" OnValidSubmit="DeleteMWorkTime" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(mworktime is null)">削除</button> |
            <a href="/mworktimes">一覧に戻る</a>
        </EditForm>
    }
</div>

@code {
    private InputModel? mworktime;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            (mworktime, _) = await InputModelService
                .GetInputModelAsync<InputModel, MWorkTime>(Id);

            if (mworktime is null)
            {
                NavigationManager.NavigateTo("notfound");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    private async Task DeleteMWorkTime()
    {
        Logger.LogDebug("▽DeleteMWorkTime");
        try
        {
            await InputModelService.DeleteInputModelAsync<MWorkTime>(Id);
            NavigationManager.NavigateTo("/mworktimes");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△DeleteMWorkTime");
    }
}
