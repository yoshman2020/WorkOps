@page "/tattendances/edit"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>編集</PageTitle>

<h1>編集</h1>

<h2>出退勤</h2>
<hr />
@if (TAttendance is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="TAttendance" OnValidSubmit="UpdateTAttendance" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <ErrorAlert ErrorCode="@ErrorCode" />
                <div class="mb-3">
                    <label for="username" class="form-label">担当者:</label>
                    <InputText id="username" @bind-Value="TAttendance.UserName" class="form-control-plaintext" readonly />
                    <ValidationMessage For="() => TAttendance.UserName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">日付:</label>
                    <InputDate Type="InputDateType.Date" id="date" @bind-Value="TAttendance.Date" class="form-control-plaintext" readonly />
                    <ValidationMessage For="() => TAttendance.Date" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="starttime" class="form-label">開始時間:</label>
                    <InputDate Type="InputDateType.Time" id="starttime" @bind-Value="TAttendance.StartTime" class="form-control" />
                    <ValidationMessage For="() => TAttendance.StartTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="endtime" class="form-label">終了時間:</label>
                    <InputDate Type="InputDateType.Time" id="endtime" @bind-Value="TAttendance.EndTime" class="form-control" />
                    <ValidationMessage For="() => TAttendance.EndTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="paidleavedurationtime" class="form-label">有給時間:</label>
                    <InputDate Type="InputDateType.Time" id="paidleavedurationtime" @bind-Value="TAttendance.PaidLeaveDurationTime" class="form-control" />
                    <ValidationMessage For="() => TAttendance.PaidLeaveDurationTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="workeddurationtime" class="form-label">勤務時間:</label>
                    <InputDate Type="InputDateType.Time" id="workeddurationtime" @bind-Value="TAttendance.WorkedDurationTime" class="form-control" />
                    <ValidationMessage For="() => TAttendance.WorkedDurationTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="overtimedurationtime" class="form-label">時間外:</label>
                    <InputDate Type="InputDateType.Time" id="overtimedurationtime" @bind-Value="TAttendance.OvertimeDurationTime" class="form-control" />
                    <ValidationMessage For="() => TAttendance.OvertimeDurationTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="remarks" class="form-label">備考:</label>
                    <InputText id="remarks" @bind-Value="TAttendance.Remarks" class="form-control" />
                    <ValidationMessage For="() => TAttendance.Remarks" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="logintime" class="form-label">ログイン:</label>
                    <InputDate Type="InputDateType.Time" id="logintime" @bind-Value="TAttendance.LoginTime" class="form-control-plaintext" readonly />
                    <ValidationMessage For="() => TAttendance.LoginTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="logouttime" class="form-label">ログアウト:</label>
                    <InputDate Type="InputDateType.Time" id="logouttime" @bind-Value="TAttendance.LogoutTime" class="form-control-plaintext" readonly />
                    <ValidationMessage For="() => TAttendance.LogoutTime" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">保存</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/tattendances?userid=@TAttendance!.UserId">一覧に戻る</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel? TAttendance { get; set; }

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        (TAttendance, var _) = await InputModelService
            .GetInputModelAsync<InputModel, TAttendance>(Id);

        if (TAttendance is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        TAttendance!.UserName = UserService.GetUserName(TAttendance!.UserId);

        var dateDateTime = TAttendance!.Date.ToDateTime(TimeOnly.MinValue);
        TAttendance!.PaidLeaveDurationTime =
            dateDateTime + TAttendance!.PaidLeaveDuration;
        TAttendance!.WorkedDurationTime =
            dateDateTime + TAttendance!.WorkedDuration;
        TAttendance!.OvertimeDurationTime =
            dateDateTime + TAttendance!.OvertimeDuration;
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTAttendance()
    {
        TAttendance!.PaidLeaveDuration =
            TAttendance!.PaidLeaveDurationTime?.TimeOfDay;
        TAttendance!.WorkedDuration =
            TAttendance!.WorkedDurationTime?.TimeOfDay;
        TAttendance!.OvertimeDuration =
            TAttendance!.OvertimeDurationTime?.TimeOfDay;
        TAttendance!.IsModified = true;

        try
        {
            ErrorCode = await InputModelService
                .SaveInputModelAsync<InputModel, TAttendance>(TAttendance!, Id);
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TAttendanceExists(TAttendance!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        if (ErrorCode == WorkOps.Models.Errors.ErrorCode.None)
        {
            NavigationManager.NavigateTo(
                $"/tattendances?userid={TAttendance!.UserId}");
        }
    }

    private bool TAttendanceExists(int id)
    {
        return DbContext.TAttendance.Any(e => e.Id == id);
    }

    /// <summary>
    /// TimeSpanをTimeOnlyに変換（null対応）
    /// </summary>
    /// <param name="timeSpan">TimeSpan?</param>
    /// <returns>TimeOnly?</returns>
    private TimeOnly? TimeSpanToTimeOnly(TimeSpan? timeSpan)
    {
        return timeSpan is TimeSpan
            ? TimeOnly.FromTimeSpan(timeSpan ?? default) : null;
    }
}
