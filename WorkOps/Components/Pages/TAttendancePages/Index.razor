@page "/tattendances"
@using Microsoft.AspNetCore.Components.QuickGrid
@using WorkOps.Models.Enums
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject WorkOps.Services.PrevInputCheckService PrevInputCheckService
@inject WorkOps.Services.MailService MailService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Index> Logger
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>出退勤</PageTitle>

<h1>出退勤</h1>

<ErrorAlert Message="@notifications" ErrorCode="@errorCode" />

<form action="/tattendances" data-enhance data-parmanent>
    <div class="row">
        <div class="col-auto d-flex align-items-center">
            <select id="user" @bind="UserId" class="form-select" aria-required="true">
                @foreach (var user in Users)
                {
                    <option value="@user.Id">@user.FullName</option>
                }
            </select>
        </div>
        <div class="col-auto d-flex align-items-center">
            <input type="date" id="datefrom" @bind="DateFrom" class="form-control" />
            ～
            <input type="date" id="dateTo" @bind="DateTo" class="form-control" />
        </div>
        <div class="col-auto d-flex align-items-center">
            <button id="prev" @onclick="() => ChangeMonthAsync(-1)" class="btn btn-primary">
           &lt;
            </button>
            <button id="current" @onclick="() => ChangeMonthAsync(0)" class="btn btn-primary">
           &cir;
            </button>
            <button id="prev" @onclick="() => ChangeMonthAsync(1)" class="btn btn-primary">
           &gt;
            </button>
        </div>
        <div class="col-auto d-flex align-items-center">
            <button id="excel" @onclick="DownloadExcelAsync" class="btn btn-primary">Excel出力</button>
        </div>
        @if (IsDisplayOneMonth())
        {
            // 1ヶ月表示のときのみステータス遷移を表示
            <div class="col-auto d-flex align-items-center">
                <StatusStepNavigation
                    TEnum="ApprovalStatus"
                    CurrentStatus="@currentStatus"
                    OnStepClick="OnStepClickAsync"
                    ClickableStatuses="@clickableStatuses"/>
            </div>
        }
    </div>
</form>

<div class="grid">
<QuickGrid Class="table" Items="InputModels!.AsQueryable()" RowClass="GetRowClass">
    <DisplayPropertyColumn Property="tattendance => tattendance.Date" Format="yyyy/MM/dd(ddd)" />
    <DisplayPropertyColumn Property="tattendance => tattendance.HolidayName" />
    <DisplayPropertyColumn Property="tattendance => tattendance.StartTime" Format="HH:mm" />
    <DisplayPropertyColumn Property="tattendance => tattendance.EndTime" Format="HH:mm" />
    <DisplayPropertyColumn Property="tattendance => tattendance.PaidLeaveDurationString" />
    <DisplayPropertyColumn Property="tattendance => tattendance.WorkedDurationString" />
    <DisplayPropertyColumn Property="tattendance => tattendance.OvertimeDurationString" />
    <TemplateColumn Context="tattendance" Class="text-nowrap">
        <div class="@GetRowClass(tattendance)">
            @if (tattendance.CanEdit)
            {
                <a href="@GetEditOrCreateUrl(tattendance)">編集</a>@: |
            }
            else
            {
                <span class="text-muted">編集</span><span> | </span>
            }
            @if (tattendance.Id != 0)
            {
                <a href="@($"tattendances/details?id={tattendance.Id}")">詳細</a> @: |
            }
            else
            {
                <span class="text-muted">詳細</span><span> | </span>
            }
            @if (tattendance.Id != 0 && tattendance.CanEdit)
            {
                <a href="@($"tattendances/delete?id={tattendance.Id}")">削除</a>
            }
            else
            {
                <span class="text-muted">削除</span>
            }
        </div>
    </TemplateColumn>
    <DisplayPropertyColumn Property="tattendance => tattendance.Remarks" />
    <DisplayPropertyColumn Property="tattendance => tattendance.WorkDetailAm" Class="text-nowrap text-start" />
    <DisplayPropertyColumn Property="tattendance => tattendance.WorkDetailPm" Class="text-nowrap text-start" />
    <DisplayPropertyColumn Property="tattendance => tattendance.LoginTime" Format="HH:mm" />
    <DisplayPropertyColumn Property="tattendance => tattendance.LogoutTime" Format="HH:mm" />
    <TemplateColumn Context="tattendance">
        <HeaderTemplate>
            <div class="col-title text-nowrap">修正あり</div>
        </HeaderTemplate>
        <ChildContent>
            <div class="form-check d-flex justify-content-center @GetRowClass(tattendance)">
                @if (tattendance.IsModified)
                {
                    <span class="bi-pencil-fill-modified"></span>
                }
            </div>
        </ChildContent>
    </TemplateColumn>
    <TemplateColumn Context="tattendance">
        <HeaderTemplate>
            <div class="col-title text-nowrap">修正承認済み</div>
        </HeaderTemplate>
        <ChildContent>
            <div class="form-check d-flex justify-content-center @GetRowClass(tattendance)">
                @if (tattendance.IsModified)
                {
                    <input class="form-check-input" type="checkbox"
                        checked="@tattendance.IsApproved"
                        @onchange="@(e => OnChkIsApprovedClickAsync(e, tattendance))"
                        disabled="@(hassNotAuthorized || !tattendance.IsModified)">
                }
            </div>
        </ChildContent>
    </TemplateColumn>
</QuickGrid>
<table>
    <tfoot>
        <tr class="table-secondary">
            <td colspan="3">合計</td>
            <td>有給時間:</td>
            <td>@totalPaidLeave</td>
            <td>勤務時間:</td>
            <td>@totalWorked</td>
            <td>時間外:</td>
            <td>@totalOvertime</td>
            <td></td>
            <td></td>
        </tr>
        <tr class="table-secondary">
            <td></td>
            <td></td>
            <td>@totalTime</td>
            <td></td>
            <td>稼働日</td>
            <td></td>
            <td>@workingDays</td>
            <td></td>
            <td></td>
            <td>有給残:</td>
            <td>@paidLeaveRemaining</td>
        </tr>
    </tfoot>
</table>
</div>
<Paginator State="pagination" />
<script src="js/download.js"></script>