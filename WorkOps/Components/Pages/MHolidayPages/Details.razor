@page "/mholidays/details"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager

<PageTitle>詳細</PageTitle>

<h1>詳細</h1>

<div>
    <h2>休日・祝祭日</h2>
    <hr />
    @if (mholiday is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">日付</dt>
            <dd class="col-sm-10">@mholiday.Date</dd>
            <dt class="col-sm-2">名</dt>
            <dd class="col-sm-10">@mholiday.Name</dd>
            <dt class="col-sm-2">備考</dt>
            <dd class="col-sm-10">@mholiday.Remarks</dd>
            <dt class="col-sm-2">作成日時</dt>
            <dd class="col-sm-10">@mholiday.CreatedAt</dd>
            <dt class="col-sm-2">作成者</dt>
            <dd class="col-sm-10">@mholiday.CreatedUserName</dd>
            <dt class="col-sm-2">更新日時</dt>
            <dd class="col-sm-10">@mholiday.UpdatedAt</dd>
            <dt class="col-sm-2">更新者</dt>
            <dd class="col-sm-10">@mholiday.UpdatedUserName</dd>
        </dl>
        <div>
            <a href="@($"/mholidays/edit?id={mholiday.Id}")">編集</a> |
            <a href="@($"/mholidays")">一覧に戻る</a>
        </div>
    }
</div>

@code {
    private InputModel? mholiday;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        (mholiday, _) = await InputModelService
            .GetInputModelAsync<InputModel, MHoliday>(Id);

        if (mholiday is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
