@page "/mprojects"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using WorkOps.Models
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject ILogger<Index> Logger
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>プロジェクト一覧</PageTitle>

<h1>プロジェクト一覧</h1>

<p>
    <a href="mprojects/create">新規作成</a>
</p>
<p>
    <InputTextOnInput @bind-Value="nameFilter" OnInputCallback="LoadDataAsync" Placeholder="プロジェクト名で絞り込み" />
</p>

<QuickGrid Class="table" Items="InputModels" Pagination="pagination">
    <DisplayPropertyColumn Property="mproject => mproject.CustomerName" />
    <DisplayPropertyColumn Property="mproject => mproject.Name" Title="プロジェクト" />
    <DisplayPropertyColumn Property="mproject => mproject.Remarks" />
    <TemplateColumn Context="mproject">
        <a href="@($"mprojects/edit?id={mproject.Id}")">編集</a> |
        <a href="@($"mprojects/details?id={mproject.Id}")">詳細</a> |
        <a href="@($"mprojects/delete?id={mproject.Id}")">削除</a>
    </TemplateColumn>
</QuickGrid>
<Paginator State="pagination" />

@code {
    private string? nameFilter;
    private IQueryable<InputModel>? InputModels;
    PaginationState pagination = new PaginationState { ItemsPerPage = 20 };

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    private async Task LoadDataAsync()
    {
        Logger.LogDebug("▼LoadDataAsync");
        try
        {
            (InputModels, var entities) = await InputModelService
                .GetInputModelsAsync<InputModel, MProject>();

            if (!string.IsNullOrWhiteSpace(nameFilter))
            {
                InputModels = InputModels.Where(
                    im => im.Name.Contains(nameFilter));
            }

            entities.Include(e => e.MCustomer);

            foreach (var inputModel in InputModels)
            {
                inputModel.CustomerName = entities
                    .Where(e => e.Id == inputModel.Id)
                    .Select(e => e.MCustomer.Name)
                    .FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("▲LoadDataAsync");
    }
}
