@page "/mcustomers/edit"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>編集</PageTitle>

<h1>編集</h1>

<h2>顧客</h2>
<hr />
@if (MCustomer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="MCustomer" OnValidSubmit="UpdateMCustomer" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <ErrorAlert ErrorCode="@ErrorCode" />
                <div class="mb-3">
                    <label for="name" class="form-label">顧客名:</label>
                    <InputText id="name" @bind-Value="MCustomer.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => MCustomer.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="remarks" class="form-label">備考:</label>
                    <InputText id="remarks" @bind-Value="MCustomer.Remarks" class="form-control" />
                    <ValidationMessage For="() => MCustomer.Remarks" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">保存</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/mcustomers">一覧に戻る</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel? MCustomer { get; set; }

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        (MCustomer, _) = await InputModelService
            .GetInputModelAsync<InputModel, MCustomer>(Id);

        if (MCustomer is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateMCustomer()
    {
        try
        {
            ErrorCode = await InputModelService
                .SaveInputModelAsync<InputModel, MCustomer>(MCustomer!, Id);
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MCustomerExists(MCustomer!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        if (ErrorCode == WorkOps.Models.Errors.ErrorCode.None)
        {
            NavigationManager.NavigateTo("/mcustomers");
        }
    }

    private bool MCustomerExists(int id)
    {
        return DbContext.MCustomer.Any(e => e.Id == id);
    }
}
