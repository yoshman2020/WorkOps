@page "/mphases/delete"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@inject ILogger<Delete> Logger

<PageTitle>削除</PageTitle>

<h1>削除</h1>

<p>削除します。よろしいですか？</p>
<div>
    <h2>工程</h2>
    <hr />
    @if (mphase is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <ErrorAlert ErrorCode="@ErrorCode" Args="@Args" />
        <dl class="row">
            <dt class="col-sm-2">プロジェクト</dt>
            <dd class="col-sm-10">@mphase.ProjectName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">工程</dt>
            <dd class="col-sm-10">@mphase.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">備考</dt>
            <dd class="col-sm-10">@mphase.Remarks</dd>
        </dl>
        <EditForm method="post" Model="mphase" OnValidSubmit="DeleteMPhase" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(mphase is null)">削除</button> |
            <a href="/mphases">一覧に戻る</a>
        </EditForm>
    }
</div>

@code {
    private InputModel? mphase;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    /// <summary>
    /// エラーメッセージ引数
    /// </summary>
    private object[]? Args { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            (mphase, var entity) = await InputModelService
                .GetInputModelAsync<InputModel, MPhase>(Id);

            if (mphase is null)
            {
                NavigationManager.NavigateTo("notfound");
            }

            await DbContext.Entry(entity!)
                .Reference(e => e.MProject)
                .LoadAsync();
            await DbContext.Entry(entity!.MProject)
                .Reference(e => e.MCustomer)
                .LoadAsync();
            mphase!.CustomerName = entity!.MProject.MCustomer.Name;
            mphase!.ProjectName = entity!.MProject.Name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    private async Task DeleteMPhase()
    {
        Logger.LogDebug("▽DeleteMPhase");
        try
        {
            var errorCode = await InputModelService
                .DeleteInputModelAsync<MPhase, TActual, TPlan>(Id);

            if (errorCode == WorkOps.Models.Errors.ErrorCode.None)
            {
                NavigationManager.NavigateTo("/mphases");
                return;
            }

            Args = ["予定または実績"];
            ErrorCode = errorCode;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△DeleteMPhase");
    }
}
