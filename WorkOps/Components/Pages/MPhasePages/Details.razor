@page "/mphases/details"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager

<PageTitle>詳細</PageTitle>

<h1>詳細</h1>

<div>
    <h2>工程</h2>
    <hr />
    @if (mphase is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">プロジェクト</dt>
            <dd class="col-sm-10">@mphase.ProjectName</dd>
            <dt class="col-sm-2">工程</dt>
            <dd class="col-sm-10">@mphase.Name</dd>
            <dt class="col-sm-2">備考</dt>
            <dd class="col-sm-10">@mphase.Remarks</dd>
            <dt class="col-sm-2">作成日時</dt>
            <dd class="col-sm-10">@mphase.CreatedAt</dd>
            <dt class="col-sm-2">作成者</dt>
            <dd class="col-sm-10">@mphase.CreatedUserName</dd>
            <dt class="col-sm-2">更新日時</dt>
            <dd class="col-sm-10">@mphase.UpdatedAt</dd>
            <dt class="col-sm-2">更新者</dt>
            <dd class="col-sm-10">@mphase.UpdatedUserName</dd>
        </dl>
        <div>
            <a href="@($"/mphases/edit?id={mphase.Id}")">編集</a> |
            <a href="@($"/mphases")">一覧に戻る</a>
        </div>
    }
</div>

@code {
    private InputModel? mphase;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        (mphase, var entity) = await InputModelService
            .GetInputModelAsync<InputModel, MPhase>(Id);

        if (mphase is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        await DbContext.Entry(entity!)
            .Reference(e => e.MProject)
            .LoadAsync();
        await DbContext.Entry(entity!.MProject)
            .Reference(e => e.MCustomer)
            .LoadAsync();
        mphase!.CustomerName = entity!.MProject.MCustomer.Name;
        mphase!.ProjectName = entity!.MProject.Name;
    }
}
