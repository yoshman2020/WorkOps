@page "/tplans/details"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject NavigationManager NavigationManager
@inject ILogger<Details> Logger

<PageTitle>詳細</PageTitle>

<h1>詳細</h1>

<div>
    <h2>予定</h2>
    <hr />
    @if (tplan is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">担当者</dt>
            <dd class="col-sm-10">@tplan.UserName</dd>
            <dt class="col-sm-2">プロジェクト</dt>
            <dd class="col-sm-10">@tplan.ProjectName</dd>
            <dt class="col-sm-2">工程</dt>
            <dd class="col-sm-10">@tplan.PhaseName</dd>
            <dt class="col-sm-2">開始日時</dt>
            <dd class="col-sm-10">@tplan.StartDate.ToString("yyyy/MM/dd HH:mm:ss")</dd>
            <dt class="col-sm-2">終了日時</dt>
            <dd class="col-sm-10">@tplan.EndDate.ToString("yyyy/MM/dd HH:mm:ss")</dd>
            <dt class="col-sm-2">作業工数</dt>
            <dd class="col-sm-10">@tplan.ManHour</dd>
            <dt class="col-sm-2">備考</dt>
            <dd class="col-sm-10">@tplan.Remarks</dd>
            <dt class="col-sm-2">作成日時</dt>
            <dd class="col-sm-10">@tplan.CreatedAt</dd>
            <dt class="col-sm-2">作成者</dt>
            <dd class="col-sm-10">@tplan.CreatedUserName</dd>
            <dt class="col-sm-2">更新日時</dt>
            <dd class="col-sm-10">@tplan.UpdatedAt</dd>
            <dt class="col-sm-2">更新者</dt>
            <dd class="col-sm-10">@tplan.UpdatedUserName</dd>
        </dl>
        <div>
            <a href="@($"/tplans/edit?id={tplan.Id}")">編集</a> |
            <a href="@($"/tplanactuals")">一覧に戻る</a>
        </div>
    }
</div>

@code {
    private InputModel? tplan;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            (tplan, var entity) = await InputModelService
                .GetInputModelAsync<InputModel, TPlan>(Id);

            if (tplan is null || entity is null)
            {
                NavigationManager.NavigateTo("notfound");
            }

            tplan!.UserName = UserService.GetUserName(entity!.UserId);
            await DbContext.Entry(entity!.MPhase)
                .Reference(e => e.MProject)
                .LoadAsync();
            await DbContext.Entry(entity!)
                .Reference(e => e.User)
                .LoadAsync();
            tplan!.ProjectName = entity!.MPhase.MProject.Name;
            tplan!.PhaseName = entity!.MPhase.Name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }
}
