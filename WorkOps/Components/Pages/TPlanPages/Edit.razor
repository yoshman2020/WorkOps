@page "/tplans/edit"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject WorkOps.Services.NavigationService NavigationService
@inject WorkOps.Services.BusinessDayService BusinessDayService
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>編集</PageTitle>

<h1>編集</h1>

<h2>予定</h2>
<hr />
@if (TPlan is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="TPlan" OnSubmit="UpdateTPlan" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <ErrorAlert ErrorCode="@ErrorCode" />
                <div class="mb-3">
                    <label for="username" class="form-label">担当者:</label>
                    <InputText id="username" @bind-Value="TPlan!.UserName" class="form-control-plaintext" readonly />
                    <ValidationMessage For="() => TPlan.UserName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="customer" class="form-label">顧客</label>
                    <div class="input-group">
                        <select id="customer" @bind="MCustomerId" @bind:after="OnCustomerValueChange" class="form-select" aria-required="true">
                            <option value="0">-- 顧客選択 --</option>
                            @foreach (var customer in Customers)
                            {
                                <option value="@customer.Id">@customer.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" @onclick="OnBtnNewCustomerClick">新規</button>
                    </div>
                    <ValidationMessage For="() => MCustomerId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="project" class="form-label">プロジェクト</label>
                    <div class="input-group">
                        <select id="project" @bind="MProjectId" @bind:after="OnProjectValueChange" class="form-select" aria-required="true">
                            <option value="0">-- プロジェクト選択 --</option>
                            @foreach (var project in Projects)
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" @onclick="OnBtnNewProjectClick">新規</button>
                    </div>
                    <ValidationMessage For="() => MProjectId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="phase" class="form-label">工程</label>
                    <div class="input-group">
                        <InputSelect id="phase" @bind-Value="TPlan.MPhaseId" class="form-select" aria-required="true">
                            <option value="0">-- 工程選択 --</option>
                            @foreach (var phase in Phases)
                            {
                                <option value="@phase.Id">@phase.Name</option>
                            }
                        </InputSelect>
                        <button type="button" class="btn btn-primary" @onclick="OnBtnNewPhaseClick">新規</button>
                    </div>
                    <ValidationMessage For="() => TPlan.MPhaseId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">開始日時:</label>
                    <InputDate Type="InputDateType.DateTimeLocal"
                               id="startdate"
                               @bind-Value="TPlan.StartDate"
                               @bind-Value:after="CalculateManHour"
                               class="form-control" />
                    <ValidationMessage For="() => TPlan.StartDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="enddate" class="form-label">終了日時:</label>
                    <InputDate Type="InputDateType.DateTimeLocal"
                               id="enddate"
                               @bind-Value="TPlan.EndDate"
                               @bind-Value:after="CalculateManHour"
                               class="form-control" />
                    <ValidationMessage For="() => TPlan.EndDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="manhour" class="form-label">作業工数:</label>
                    <InputNumber id="manhour" @bind-Value="TPlan.ManHour" class="form-control" />
                    <ValidationMessage For="() => TPlan.ManHour" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="remarks" class="form-label">備考:</label>
                    <InputText id="remarks" @bind-Value="TPlan.Remarks" class="form-control" />
                    <ValidationMessage For="() => TPlan.Remarks" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">保存</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteTPlan">削除</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/tplanactuals">一覧に戻る</a>
</div>

@code {
    /// <summary>
    /// 顧客ID
    /// </summary>
    [SupplyParameterFromQuery]
    private int? MCustomerId { get; set; }
    /// <summary>
    /// プロジェクトID
    /// </summary>
    [SupplyParameterFromQuery]
    private int? MProjectId { get; set; }
    /// <summary>
    /// 工程ID
    /// </summary>
    [SupplyParameterFromQuery]
    private int? MPhaseId { get; set; }
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel? TPlan { get; set; }
    private List<MCustomer> Customers = new();
    private List<MProject> Projects = new();
    private List<MPhase> Phases = new();

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        // -----------------------------
        // 顧客・プロジェクト・工程リスト初期化
        // -----------------------------
        Customers = await DbContext.MCustomer.OrderBy(c => c.Id).ToListAsync();
        Projects = await DbContext.MProject.OrderBy(p => p.Id).ToListAsync();
        Phases = new();

        // -----------------------------
        // DBから既存TPlan取得
        // -----------------------------
        (TPlan, var entity) = await InputModelService
            .GetInputModelAsync<InputModel, TPlan>(Id);

        if (TPlan is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        TPlan.UserName = UserService.GetUserName(entity!.UserId);

        // -----------------------------
        // URLパラメータのIDを優先、未設定の場合はDB値を使用
        // -----------------------------
        MCustomerId ??= 0;
        MProjectId ??= 0;
        MPhaseId ??= 0;

        // 1. PhaseId がある場合 → Project, Customer を復元
        if (MPhaseId != 0)
        {
            var phase = await DbContext.MPhase
                .Where(p => p.Id == MPhaseId)
                .FirstOrDefaultAsync();

            if (phase != null)
            {
                MProjectId = phase.MProjectId;

                var project = await DbContext.MProject
                    .Where(p => p.Id == MProjectId)
                    .FirstOrDefaultAsync();

                if (project != null)
                    MCustomerId = project.MCustomerId;
            }
            else
            {
                MPhaseId = 0;
            }
        }
        // 2. ProjectId がある場合 → Customer を復元
        else if (MProjectId != 0)
        {
            var project = await DbContext.MProject
                .Where(p => p.Id == MProjectId)
                .FirstOrDefaultAsync();

            if (project != null)
                MCustomerId = project.MCustomerId;
        }
        // 3. CustomerId のみある場合 → Project は絞り込み、Phase は空
        else if (MCustomerId != 0)
        {
            Projects = await DbContext.MProject
                .Where(p => p.MCustomerId == MCustomerId)
                .OrderBy(p => p.Id)
                .ToListAsync();

            MProjectId = 0;
            Phases = new List<MPhase>();
        }
        // 4. URLにもIDがない場合 → DB値から復元
        else
        {
            if (entity.MPhaseId != 0)
            {
                MPhaseId = entity.MPhaseId;
                await DbContext.Entry(entity).Reference(e => e.MPhase).LoadAsync();
                if (entity.MPhase != null)
                {
                    MProjectId = entity.MPhase.MProjectId;
                    await DbContext.Entry(entity.MPhase).Reference(p => p.MProject).LoadAsync();
                    if (entity.MPhase.MProject != null)
                        MCustomerId = entity.MPhase.MProject.MCustomerId;
                }
            }
            else if (entity.MPhase?.MProjectId != 0)
            {
                MProjectId = entity.MPhase?.MProjectId;
                var project = await DbContext.MProject
                    .Where(p => p.Id == MProjectId)
                    .FirstOrDefaultAsync();

                if (project != null)
                    MCustomerId = project.MCustomerId;
            }
        }

        // -----------------------------
        // プロジェクト・工程リストの絞り込み
        // -----------------------------
        Projects = (MCustomerId != 0)
            ? await DbContext.MProject
                .Where(p => p.MCustomerId == MCustomerId)
                .OrderBy(p => p.Id)
                .ToListAsync()
            : Projects;

        Phases = (MProjectId != 0)
            ? await DbContext.MPhase
                .Where(p => p.MProjectId == MProjectId)
                .OrderBy(p => p.Id)
                .ToListAsync()
            : new List<MPhase>();

        // -----------------------------
        // TPlan に復元（PhaseId は最後にセット）
        // -----------------------------
        TPlan.MPhaseId = MPhaseId ?? 0;
    }

    private async Task OnCustomerValueChange()
    {
        if (MCustomerId == null || MCustomerId == 0)
        {
            Projects = await DbContext.MProject.ToListAsync();
            MProjectId = 0;
            Phases = new();
            return;
        }

        Projects = await DbContext.MProject
            .Where(p => p.MCustomerId == MCustomerId)
            .ToListAsync();

        MProjectId = 0;
        Phases = new();
    }

    private async Task OnProjectValueChange()
    {
        if (MProjectId == null || MProjectId == 0)
        {
            Phases = new();
            TPlan!.MPhaseId = 0;
            return;
        }

        Phases = await DbContext.MPhase
            .Where(p => p.MProjectId == MProjectId)
            .ToListAsync();

        TPlan!.MPhaseId = 0;

        // 顧客も同期
        MCustomerId = await DbContext.MProject
            .Where(p => p.Id == MProjectId)
            .Select(p => p.MCustomerId)
            .FirstOrDefaultAsync();
    }

    /// <summary>
    // 作業工数計算
    /// </summary>
    private async Task CalculateManHour()
    {
        if (TPlan is null) return;

        // 作業工数計算
        var duration = await BusinessDayService.CalculateWorkDurationAsync(
            TPlan.UserId,
            TPlan.StartDate,
            TPlan.EndDate
        );

        TPlan.ManHour = Math.Round(
            duration.TotalHours, 1, MidpointRounding.AwayFromZero);
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTPlan(EditContext context)
    {
        var project = Projects.FirstOrDefault(p => p.Id == MProjectId)?.Name;
        var phase = Phases.FirstOrDefault(p => p.Id == TPlan!.MPhaseId)?.Name;
        TPlan!.Name = $"{TPlan.StartDate:yyyy/MM/dd} {project} {phase}";

        if (!context.Validate() || TPlan!.MPhaseId == 0)
        {
            return;
        }

        try
        {
            ErrorCode = await InputModelService
                .SaveInputModelAsync<InputModel, TPlan>(TPlan!, Id, false);
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TPlanExists(TPlan!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        if (ErrorCode == WorkOps.Models.Errors.ErrorCode.None)
        {
            NavigationService.NavigateToBack(null, null, null,
                $"tplanactuals?userid={TPlan.UserId}");
        }
    }

    private async Task DeleteTPlan()
    {
        await InputModelService.DeleteInputModelAsync<TPlan>(Id);
        NavigationManager.NavigateTo("/tplanactuals");
    }

    private bool TPlanExists(int id)
    {
        return DbContext.TPlan.Any(e => e.Id == id);
    }

    private void OnBtnNewCustomerClick(MouseEventArgs args)
    {
        NavigationService.NavigateToCreatet("mcustomers");
    }

    private void OnBtnNewProjectClick(MouseEventArgs args)
    {
        NavigationService.NavigateToCreatet(
            "mprojects", $"mcustomerid={MCustomerId}");
    }

    private void OnBtnNewPhaseClick(MouseEventArgs args)
    {
        NavigationService.NavigateToCreatet(
            "mphases", $"mprojectid={MProjectId}");
    }
}
