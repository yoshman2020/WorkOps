@page "/treports/details"
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Utils
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject NavigationManager NavigationManager
@inject ILogger<Details> Logger

<PageTitle>詳細</PageTitle>

<h1>詳細</h1>

<div>
    <h2>週間報告書</h2>
    <hr />
    @if (treport is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">担当者</dt>
            <dd class="col-sm-10">@treport.UserName</dd>
            <dt class="col-sm-2">日付</dt>
            <dd class="col-sm-10">@treport.DateString</dd>
            @foreach (var detail in @treport.InputDetailModels)
            {
                <dt class="col-sm-2 text-nowrap">@detail.IndexNo プロジェクト名</dt>
                <dd class="col-sm-10">@detail.ProjectName</dd>
                <dt class="col-sm-2 text-nowrap">@detail.IndexNo－１ 作業内容</dt>
                <dd class="col-sm-10"><pre>@detail.Description</pre></dd>
                <dt class="col-sm-2 text-nowrap">@detail.IndexNo－２ 課題・問題</dt>
                <dd class="col-sm-10"><pre>@detail.Problem</pre></dd>
                <dt class="col-sm-2 text-nowrap">@detail.IndexNo－３ 今後の予定</dt>
                <dd class="col-sm-10"><pre>@detail.Schedule</pre></dd>
            }
            <dt class="col-sm-2">備考</dt>
            <dd class="col-sm-10">@treport.Remarks</dd>
            <dt class="col-sm-2">作成日時</dt>
            <dd class="col-sm-10">@treport.CreatedAt</dd>
            <dt class="col-sm-2">作成者</dt>
            <dd class="col-sm-10">@treport.CreatedUserName</dd>
            <dt class="col-sm-2">更新日時</dt>
            <dd class="col-sm-10">@treport.UpdatedAt</dd>
            <dt class="col-sm-2">更新者</dt>
            <dd class="col-sm-10">@treport.UpdatedUserName</dd>
        </dl>
        <div>
            <a href="@($"/treports/edit?id={treport.Id}")">編集</a> |
            <a href="@($"/treports")">一覧に戻る</a>
        </div>
    }
</div>

@code {
    private InputModel? treport;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            (treport, var entity) = await InputModelService
                .GetInputModelAsync<InputModel, TReport>(Id);

            if (treport is null || entity is null)
            {
                NavigationManager.NavigateTo("notfound");
            }

            treport!.DateString =
                $"{treport.Date:yyyy/MM/dd} ～ {treport.Date.AddDays(6):MM/dd}";
            treport!.UserName = UserService.GetUserName(treport.UserId);
            await DbContext.Entry(entity!)
                .Collection(e => e.TReportDetails)
                .LoadAsync();

            treport.InputDetailModels = entity!.TReportDetails
                .Select((d, index) =>
                    {
                        DbContext.Entry(d)
                            .Reference(e => e.MProject)
                            .Load();
                        var detailModel = new InputDetailModel();
                        PropertyUtil.CopyProperties(d, detailModel);
                        detailModel.IndexNo =
                            StringUtil.ConvertDigitsToFullWidth(index);
                        detailModel.ProjectName = d.MProject?.Name ?? "その他";
                        return detailModel;
                    })
                    .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }
}
