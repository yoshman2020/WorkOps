@page "/treports"
@using DocumentFormat.OpenXml
@using DocumentFormat.OpenXml.Packaging
@using DocumentFormat.OpenXml.Wordprocessing
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.Extensions.Options
@using WorkOps.Data
@using WorkOps.Extensions
@using WorkOps.Models
@using WorkOps.Models.Enums
@using WorkOps.Services
@using WorkOps.Utils
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject WorkOps.Services.MailService MailService
@inject IOptions<AppSettings> AppSettings
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Index> Logger
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>週間報告書</PageTitle>

<h1>週間報告書</h1>

<form action="/treports" data-enhance data-parmanent>
    <div class="row">
        <div class="col-auto">
            <select id="user" @bind="UserId" class="form-select" aria-required="true">
                @foreach (var user in Users)
                {
                    <option value="@user.Id">@user.FullName</option>
                }
            </select>
        </div>
        <div class="col-auto d-flex">
            <input type="month" id="month" @bind="Month" class="form-control" />
        </div>
        <div class="col-auto">
            <button id="prev" @onclick="() => ChangeMonthAsync(-1)" class="btn btn-primary">
                &lt;
            </button>
            <button id="current" @onclick="() => ChangeMonthAsync(0)" class="btn btn-primary">
                &cir;
            </button>
            <button id="prev" @onclick="() => ChangeMonthAsync(1)" class="btn btn-primary">
                &gt;
            </button>
        </div>
        <div class="col">
            <button id="excel" @onclick="DownloadWordAsync" class="btn btn-primary">Word出力</button>
        </div>
    </div>
</form>

<QuickGrid Class="table quickgrid-widthauto quickgrid-align-middle" Items="InputModels!.AsQueryable()">
    <DisplayPropertyColumn Property="treport => treport.DateString" />
    <DisplayPropertyColumn Property="treport => treport.Description" />
    <TemplateColumn Context="treport">
        @if (treport.CanEdit)
        {
            <a href="@GetEditOrCreateUrl(treport)">編集</a>@: |
        }
        else
        {
            <span class="text-muted">編集</span><span> | </span>
        }
        @if (treport.Id != 0)
        {
            <a href="@($"treports/details?id={treport.Id}")">詳細</a> @: |
        }
        else
        {
            <span class="text-muted">詳細</span><span> | </span>
        }
        @if (treport.Id != 0 && treport.CanEdit)
        {
            <a href="@($"treports/delete?id={treport.Id}")">削除</a>
        }
        else
        {
            <span class="text-muted">削除</span>
        }
    </TemplateColumn>
    <TemplateColumn Context="treport">
        <StatusStepNavigation
            TEnum="ApprovalStatus"
            CurrentStatus="@treport.ApprovalStatus"
            OnStepClick="(status) => OnStepClickAsync(status, treport.Id)"
            ClickableStatuses="@treport.ClickableStatuses"
            HiddenStatuses="@hiddenStatuses"
            IsShortName="true"
            />
    </TemplateColumn>
</QuickGrid>
<script src="js/download.js"></script>

@code {
    private string _userId = string.Empty;
    [SupplyParameterFromQuery]
    private string UserId
    {
        get => _userId;
        set
        {
            if (_userId != value)
            {
                _userId = value;
#pragma warning disable CS4014 // この呼び出しは待機されなかったため、現在のメソッドの実行は呼び出しの完了を待たずに続行されます
                LoadSelectedDataAsync();
#pragma warning restore CS4014 // この呼び出しは待機されなかったため、現在のメソッドの実行は呼び出しの完了を待たずに続行されます
            }
        }
    }
    private DateOnly _month;
    private DateOnly Month
    {
        get => _month;
        set
        {
            if (_month != value)
            {
                _month = value;
#pragma warning disable CS4014 // この呼び出しは待機されなかったため、現在のメソッドの実行は呼び出しの完了を待たずに続行されます
                LoadSelectedDataAsync();
#pragma warning restore CS4014 // この呼び出しは待機されなかったため、現在のメソッドの実行は呼び出しの完了を待たずに続行されます
            }
        }
    }
    private List<InputModel>? InputModels;
    private List<ApplicationUser> Users = [];

    /// <summary>
    /// 非表示にするステータス
    /// </summary>
    private List<ApprovalStatus> hiddenStatuses = [
        ApprovalStatus.UnderReviewByStaff,
        ApprovalStatus.ReviewedPendingApproval
    ];

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            Users = await UserService.GetUsersAsync();
            UserId = await UserService.GetUserIdAsync(Users, UserId);
            if (_month == default || _month == DateOnly.MinValue)
            {
                // 未設定の場合は当月
                var today = DateTime.Today;
                Month = new DateOnly(today.Year, today.Month, 1);
            }

            await LoadSelectedDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    /// <summary>
    /// ステータスクリック
    /// </summary>
    /// <param name="status">更新するステータス</param>
    private async Task OnStepClickAsync(ApprovalStatus status, int reportId)
    {
        Logger.LogDebug("▽OnStepClick");
        try
        {
            // ステータス更新
            await UpdateStatusAsync(status, reportId);

            // メール送信
            await SendEmailAsync(status);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnStepClick");
    }

    /// <summary>
    /// Word保存
    /// </summary>
    private async Task DownloadWordAsync()
    {
        Logger.LogDebug("▽DownloadWordAsync");
        if (InputModels == null || InputModels.Count == 0)
        {
            return;
        }

        try
        {
            var userName = UserService.GetUserName(UserId);

            using var wordMs = await CreateWordMemoryStreamAsync(userName);
            using var streamRef = new DotNetStreamReference(stream: wordMs);

            var fileName = $"週間報告書{Month:yyyy-MM}({userName}).docx";
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△DownloadWordAsync");
    }

    /// <summary>
    /// データ読み込み
    /// </summary>
    /// <returns></returns>
    private async Task LoadSelectedDataAsync()
    {
        Logger.LogDebug("▼LoadSelectedDataAsync");
        try
        {
            InputModels = await LoadDataAsync(_month);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("▲LoadSelectedDataAsync");
    }

    /// <summary>
    /// データ読み込み
    /// </summary>
    /// <param name="month">月</param>
    /// <returns></returns>
    private async Task<List<InputModel>?> LoadDataAsync(DateOnly month)
    {
        List<InputModel> inputModels = [];
        try
        {
            if (month == default　|| month == DateOnly.MinValue)
            {
                return inputModels;
            }

            // 月曜日の一覧を取得
            var mondays = GetMondays(month);

            // 最初の月曜
            var firstMonday = mondays.Min();

            // 最終日の次の月曜
            var nextMonday = mondays.Max().AddDays(7);

            //  週報
            var treports = DbContext.TReport
                .Include(e => e.TReportDetails)
                .ThenInclude(td => td.MProject)
                .ThenInclude(p => p!.MCustomer)
                .Where(e => e.UserId == UserId
                    && firstMonday <= e.Date
                    && e.Date < nextMonday
                );

            // 管理者かどうか
            var isAdmin = await UserService.HasAdminRoleAsync();
            // 自身のデータかどうか
            var loginUserId = await UserService.GetUserIdAsync();
            var isOwnData = UserId == loginUserId;
            // 編集不可
            var isReadOnlyAll = !isAdmin && !isOwnData;

            var list = mondays.GroupJoin(treports,
                monday => monday,
                treport => treport.Date,
                (monday, treports) => new { monday, treports });

            inputModels = [];
            foreach (var x  in list)
            {
                var treport = x.treports.FirstOrDefault() ?? new();
                var status = treport.MApprovalStatusId.HasValue
                        ? (ApprovalStatus)treport.MApprovalStatusId.Value
                        : ApprovalStatus.NotSubmitted;
                var inputModel = new InputModel
                {
                    Id = treport.Id,
                    UserId = UserId,
                    UserName = treport.User?.FullName
                        ?? Users.FirstOrDefault(u => u.Id == UserId)?.FullName
                        ?? "",
                    Date = x.monday,
                    DateString = $"{x.monday:MM/dd} ～ {x.monday.AddDays(6):MM/dd}",
                    Description = string.Join(',',
                        x.treports.SelectMany(t => t.TReportDetails)
                        .Where(d => !string.IsNullOrEmpty(d.MProject?.Name)
                            && d.MProject.Name != "その他")
                        .Select(d =>
                            $"{d.MProject?.MCustomer?.Name} {d.MProject?.Name}")),
                    ApprovalStatus = status,
                    ClickableStatuses = await GetClickableStatusesAsync(treport),
                    CanEdit = !isReadOnlyAll && ApprovalStatusService.CanEdit(
                        status, isAdmin, isOwnData),
                };
                inputModels.Add(inputModel);
            }

            return inputModels;
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            return inputModels;
        }
    }

    /// <summary>
    /// 詳細データ読み込み
    /// </summary>
    /// <param name="id">ID</param>
    /// <returns>詳細データ</returns>
    private async Task<InputModel?> LoadDataDetailsAsync(int id)
    {
        var (treport, entity) = await InputModelService
            .GetInputModelAsync<InputModel, TReport>(id);

        if (treport is null || entity is null)
        {
            return null;
        }

        treport!.DateString =
            $"{treport.Date:yyyy/MM/dd} ～ {treport.Date.AddDays(6):MM/dd}";
        treport!.UserName = UserService.GetUserName(treport.UserId);
        await DbContext.Entry(entity!)
            .Collection(e => e.TReportDetails)
            .LoadAsync();

        treport.InputDetailModels = entity!.TReportDetails
            .Select((d, index) =>
                {
                    DbContext.Entry(d)
                        .Reference(e => e.MProject)
                        .Load();
                    var detailModel = new InputDetailModel();
                    PropertyUtil.CopyProperties(d, detailModel);
                    detailModel.IndexNo =
                        StringUtil.ConvertDigitsToFullWidth(index);
                    detailModel.ProjectName =  d.MProject?.Name == "その他"
                            ? "その他"
                            : $"{d.MProject?.MCustomer?.Name} {d.MProject?.Name}"
                            ?? "その他";
                    return detailModel;
                })
            .ToList();
        return treport;
    }

    /// <summary>
    /// 月を変更する
    /// </summary>
    /// <param name="offset">オフセット。0の場合は当月</param>
    private async Task ChangeMonthAsync(int offset)
    {
        DateService.ChangeMonth(offset, ref _month);
        await LoadSelectedDataAsync();
    }

    /// <summary>
    /// その月の月曜日の一覧を取得する
    /// </summary>
    /// <param name="month">月</param>
    /// <returns>月曜日の一覧</returns>
    public List<DateOnly> GetMondays(DateOnly month)
    {
        var mondays = new List<DateOnly>();

        // 月の1日の日付を作成
        DateTime firstDayOfMonth = new DateTime(month.Year, month.Month, 1);

        // 最初の月曜日を探す
        int daysToMonday = (
            (int)DayOfWeek.Monday - (int)firstDayOfMonth.DayOfWeek + 7) % 7;

        // 最初の月曜日の日付
        DateTime firstMonday = firstDayOfMonth.AddDays(daysToMonday);

        // 月曜日をリストに追加
        for (DateTime monday = firstMonday; monday.Month == month.Month;
            monday = monday.AddDays(7))
        {
            mondays.Add(DateOnly.FromDateTime(monday));
        }

        return mondays;
    }

    /// <summary>
    /// 更新または新規作成画面遷移URL
    /// </summary>
    /// <param name="treport">行</param>
    /// <returns>更新または新規作成画面遷移URL</returns>
    private string GetEditOrCreateUrl(InputModel treport)
    {
        if (treport.Id == 0)
        {
            return "treports/create?userid=" + UserId
            + "&date=" + treport.Date;
        }
        return "treports/edit?id=" + treport.Id;
    }
}
