@page "/msystemsettings"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@inject ILogger<Index> Logger
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>システム設定</PageTitle>

<h1>システム設定</h1>

@if (MSystemSettings is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="MSystemSettings" OnValidSubmit="UpdateMSystemSettings" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <ErrorAlert ErrorCode="@ErrorCode" />
                <div class="mb-3">
                    <InputCheckbox id="issendsubmittedstatusmail" @bind-Value="MSystemSettings.IsSendSubmittedStatusMail" class="form-check-input" />
                    <label for="issendsubmittedstatusmail" class="form-label">提出時にメールを送信する</label>
                    <ValidationMessage For="() => MSystemSettings.IsSendSubmittedStatusMail" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">保存</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private int Id = 1;

    [SupplyParameterFromForm]
    private InputModel? MSystemSettings { get; set; }

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            (MSystemSettings, _) = await InputModelService
                .GetInputModelAsync<InputModel, MSystemSettings>(Id);

            if (MSystemSettings is null)
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }
            MSystemSettings!.Name = "システム設定";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateMSystemSettings()
    {
        Logger.LogDebug("▽UpdateMSystemSettings");
        try
        {
            ErrorCode = await InputModelService
                .SaveInputModelAsync<InputModel, MSystemSettings>(MSystemSettings!, Id);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogError(ex, "Exception occurred!");
            if (!MSystemSettingsExists(MSystemSettings!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Logger.LogDebug("△UpdateMSystemSettings");
    }

    private bool MSystemSettingsExists(int id)
    {
        return DbContext.MSystemSettings.Any(e => e.Id == id);
    }
}
