@page "/applicationusers/delete"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using System.Linq.Expressions
@using WorkOps.Data
@using WorkOps.Models
@using WorkOps.Services
@using WorkOps.Utils
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.UserService UserService
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@inject ILogger<Delete> Logger
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>削除</PageTitle>

<h1>削除</h1>

<p>削除します。よろしいですか？</p>
<div>
    <h2>ユーザー</h2>
    <hr />
    @if (applicationuser is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <ErrorAlert Message="@ErrorMessage" />
        <dl class="row">
            <dt class="col-sm-2">名前</dt>
            <dd class="col-sm-10">@applicationuser.FullName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">メールアドレス</dt>
            <dd class="col-sm-10">@applicationuser.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">役職</dt>
            <dd class="col-sm-10">@applicationuser.RoleName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">勤務時間</dt>
            <dd class="col-sm-10">@applicationuser.WorkTimeString</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">前日・先週の未入力を通知する</dt>
            <dd class="col-sm-10">@applicationuser.IsPrevReminderEnabledStr</dd>
        </dl>
        <QuickGrid Items="applicationuser.PaidLeaves.AsQueryable()" TGridItem="InputPaidLeaveModel" Class="dl-quickgrid">
            <DisplayPropertyColumn Property="paidLeave => paidLeave.GrantedDays" />
            <DisplayPropertyColumn Property="paidLeave => paidLeave.GrantedDate" />
            <DisplayPropertyColumn Property="paidLeave => paidLeave.Remarks" />
        </QuickGrid>
        <EditForm method="post" Model="applicationuser" OnValidSubmit="DeleteApplicationUser" FormName="delete" Enhance>
            <div>
                <InputCheckbox id="isforcedelete" @bind-Value="applicationuser.IsForceDelete" class="form-check-input" />
                <label for="isforcedelete" class="form-label">関連データも含めて完全に削除</label>
            </div>
            <button type="submit" class="btn btn-danger" disabled="@(applicationuser is null)">削除</button> |
            <a href="/applicationusers">一覧に戻る</a>
        </EditForm>
    }
</div>

@code {
    private InputModel? applicationuser;

    [SupplyParameterFromQuery]
    private string Id { get; set; } = string.Empty;

    /// <summary>
    /// エラーメッセージ
    /// </summary>
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            if (string.IsNullOrEmpty(Id))
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }

            var user = await UserManager.FindByIdAsync(Id);
            if (user == null)
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }

            var entity = await DbContext.Users
                .FirstOrDefaultAsync(m => m.Id == Id);
            if (entity == null)
            {
                NavigationManager.NavigateTo("notfound");
            }
            var role = await UserManager.GetRolesAsync(entity!);
            var workTime = DbContext.MWorkTime
                .Where(workTime => workTime.Id == entity!.WorkTimeId)
                .FirstOrDefault();
            (var queryPaidLeaves, _) = await InputModelService
                .GetInputModelsAsync<InputPaidLeaveModel, TPaidLeave>();
            var paidLeaves = queryPaidLeaves
                .Where(p => p.UserId == entity.Id).ToList();
            applicationuser = new InputModel
            {
                RoleName = UserService.GetRoleName(role),
                WorkTimeString = workTime != null
                    ? $"{workTime.StartTime} - {workTime.EndTime}"
                    : "",
                IsPrevReminderEnabled = user!.IsPrevReminderEnabled,
                PaidLeaves = paidLeaves,
            };
            PropertyUtil.CopyProperties(entity, applicationuser);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    private async Task DeleteApplicationUser()
    {
        Logger.LogDebug("▽DeleteApplicationUser");
        try
        {
            var user = await UserManager.FindByIdAsync(Id);
            if (user == null)
            {
                NavigationManager.NavigateTo("/applicationusers");
                return;
            }

            // 自分は削除不可
            var users = await UserService.GetUsersAsync();
            var loginUserId = await UserService.GetUserIdAsync(users, "");
            if (user.Id == loginUserId)
            {
                ErrorMessage = "自分のアカウントは削除できません。";
                return;
            }

            // 関連データも含めて削除する場合
            if (applicationuser!.IsForceDelete)
            {
                // 関連レコードを削除
                DbContext.MCustomer.RemoveRange(DbContext.MCustomer.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.MHoliday.RemoveRange(DbContext.MHoliday.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.MPhase.RemoveRange(DbContext.MPhase.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.MProject.RemoveRange(DbContext.MProject.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.MWorkTime.RemoveRange(DbContext.MWorkTime.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.TActual.RemoveRange(DbContext.TActual.Where(
                    e => e.UserId == Id || e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.TAttendance.RemoveRange(DbContext.TAttendance.Where(
                    e => e.UserId == Id || e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.TPlan.RemoveRange(DbContext.TPlan.Where(
                    e => e.UserId == Id || e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.TReportDetail.RemoveRange(DbContext.TReportDetail.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
                DbContext.TReport.RemoveRange(DbContext.TReport.Where(
                    e => e.UserId == Id || e.CreatedBy == Id || e.UpdatedBy == Id));
                // 有給休暇は作成したもの
                DbContext.TPaidLeave.RemoveRange(DbContext.TPaidLeave.Where(
                    e => e.CreatedBy == Id || e.UpdatedBy == Id));
            }

            // ユーザーの有給休暇は削除
            DbContext.TPaidLeave.RemoveRange(DbContext.TPaidLeave.Where(
                e => e.UserId == Id));
            await DbContext.SaveChangesAsync();

            // 登録レコードがないか確認
            if (!applicationuser!.IsForceDelete &&
                (await HasRelatedRecords<MCustomer>(Id)
                || await HasRelatedRecords<MHoliday>(Id)
                || await HasRelatedRecords<MPhase>(Id)
                || await HasRelatedRecords<MProject>(Id)
                || await HasRelatedRecords<MWorkTime>(Id)
                || await HasRelatedRecords<TActual>(Id)
                || await HasRelatedRecords<TAttendance>(Id)
                || await HasRelatedRecords<TPlan>(Id)
                || await HasRelatedRecords<TReportDetail>(Id)
                || await HasRelatedRecords<TReport>(Id)
                || await HasRelatedRecords<TPaidLeave>(Id))
            )
            {
                // 関連レコードが存在する場合、削除しない
                user.IsDeleted = true;
                DbContext.Update(user);
                await DbContext.SaveChangesAsync();
                _ = await UserManager.SetLockoutEndDateAsync(
                    user, DateTimeOffset.MaxValue);
            }
            else
            {
                var _ = await UserManager.DeleteAsync(user);
            }
            NavigationManager.NavigateTo("/applicationusers");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△DeleteApplicationUser");
    }

    private async Task<bool> HasRelatedRecords<TEntity>(string userId)
        where TEntity : BaseEntity
    {
        var entityType = DbContext.Model.FindEntityType(typeof(TEntity));
        var parameter = Expression.Parameter(typeof(TEntity), "e");

        Expression? predicate = null;

        string[] columnsToCheck = { "UserId", "CreatedBy", "UpdatedBy" };

        foreach (var column in columnsToCheck)
        {
            var property = entityType?.FindProperty(column);
            if (property != null)
            {
                // e => EF.Property<string>(e, column) == userId
                var left = Expression.Call(
                    typeof(EF),
                    nameof(EF.Property),
                    new Type[] { typeof(string) },
                    parameter,
                    Expression.Constant(column)
                );

                var right = Expression.Constant(userId);
                var equals = Expression.Equal(left, right);

                predicate = predicate == null ? equals : Expression.OrElse(predicate, equals);
            }
        }

        if (predicate == null)
            return false; // そもそも該当列なし

        var lambda = Expression.Lambda<Func<TEntity, bool>>(predicate, parameter);
        return await DbContext.Set<TEntity>().AnyAsync(lambda);
    }
}
