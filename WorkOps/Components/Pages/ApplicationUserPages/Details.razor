@page "/applicationusers/details"
@attribute [Authorize(Roles = "Admin,Manager")]

@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WorkOps.Data
@using WorkOps.Models
@using WorkOps.Services
@using WorkOps.Utils
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject NavigationManager NavigationManager
@inject ILogger<Details> Logger

<PageTitle>詳細</PageTitle>

<h1>詳細</h1>

<div>
    <h2>ユーザー</h2>
    <hr />
    @if (applicationuser is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">名前</dt>
            <dd class="col-sm-10">@applicationuser.FullName</dd>
            <dt class="col-sm-2">メールアドレス</dt>
            <dd class="col-sm-10">@applicationuser.Email</dd>
            <dt class="col-sm-2">役職</dt>
            <dd class="col-sm-10">@applicationuser.RoleName</dd>
            <dt class="col-sm-2">勤務時間</dt>
            <dd class="col-sm-10">@applicationuser.WorkTimeString</dd>
            <dt class="col-sm-2">前日・先週の未入力を通知する</dt>
            <dd class="col-sm-10">@applicationuser.IsPrevReminderEnabledStr</dd>
        </dl>
        <QuickGrid Items="applicationuser.PaidLeaves.AsQueryable()" TGridItem="InputPaidLeaveModel" Class="dl-quickgrid">
            <DisplayPropertyColumn Property="paidLeave => paidLeave.GrantedDays" />
            <DisplayPropertyColumn Property="paidLeave => paidLeave.GrantedDate" />
            <DisplayPropertyColumn Property="paidLeave => paidLeave.Remarks" />
        </QuickGrid>
        <div>
            <a href="@($"/applicationusers/edit?id={applicationuser.Id}")">編集</a> |
            <a href="@($"/applicationusers")">一覧に戻る</a>
        </div>
    }
</div>

@code {
    private InputModel? applicationuser;

    [SupplyParameterFromQuery]
    private string Id { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            if (string.IsNullOrEmpty(Id))
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }

            var user = await UserManager.FindByIdAsync(Id);
            if (user == null)
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }

            var entity = await DbContext.Users
                .FirstOrDefaultAsync(m => m.Id == Id);
            if (entity == null)
            {
                NavigationManager.NavigateTo("notfound");
                return;
            }
            var role = await UserManager.GetRolesAsync(entity!);
            var workTime = DbContext.MWorkTime
                .Where(workTime => workTime.Id == entity!.WorkTimeId)
                .FirstOrDefault();
            (var queryPaidLeaves, _) = await InputModelService
                .GetInputModelsAsync<InputPaidLeaveModel, TPaidLeave>();
            var paidLeaves = queryPaidLeaves
                .Where(p => p.UserId == entity.Id).ToList();
            applicationuser = new InputModel
            {
                RoleName = UserService.GetRoleName(role),
                WorkTimeString = workTime != null
                    ? $"{workTime.StartTime} - {workTime.EndTime}"
                    : "",
                IsPrevReminderEnabled = user!.IsPrevReminderEnabled,
                PaidLeaves = paidLeaves,
            };
            PropertyUtil.CopyProperties(entity, applicationuser);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }
}
