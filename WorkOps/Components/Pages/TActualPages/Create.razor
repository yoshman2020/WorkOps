@page "/tactuals/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using WorkOps.Models
@using WorkOps.Models.Errors
@inject WorkOps.Data.ApplicationDbContext DbContext
@inject WorkOps.Services.InputModelService InputModelService
@inject WorkOps.Services.UserService UserService
@inject WorkOps.Services.NavigationService NavigationService
@inject WorkOps.Services.BusinessDayService BusinessDayService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Create> Logger
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>新規作成</PageTitle>

<h1>新規作成</h1>

<h2>実績</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="TActual" OnSubmit="AddTActual" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <ErrorAlert ErrorCode="@ErrorCode" />
            <div class="mb-3">
                <label for="username" class="form-label">担当者:</label>
                <InputText id="username" @bind-Value="TActual!.UserName" class="form-control-plaintext" readonly />
                <ValidationMessage For="() => TActual.UserName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="customer" class="form-label">顧客</label>
                <div class="input-group">
                    <select id="customer" @bind="MCustomerId" @bind:after="OnCustomerValueChange" class="form-select" aria-required="true">
                        <option value="0">-- 顧客選択 --</option>
                        @foreach (var customer in Customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-primary" @onclick="OnBtnNewCustomerClick">新規</button>
                </div>
                <ValidationMessage For="() => MCustomerId" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="project" class="form-label">プロジェクト</label>
                <div class="input-group">
                    <select id="project" @bind="MProjectId" @bind:after="OnProjectValueChange" class="form-select" aria-required="true">
                        <option value="0">-- プロジェクト選択 --</option>
                        @foreach (var project in Projects)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-primary" @onclick="OnBtnNewProjectClick">新規</button>
                </div>
                <ValidationMessage For="() => MProjectId" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="phase" class="form-label">工程</label>
                <div class="input-group">
                    <InputSelect id="phase" @bind-Value="TActual!.MPhaseId" class="form-select" aria-required="true">
                        <option value="0">-- 工程選択 --</option>
                        @foreach (var phase in Phases)
                        {
                            <option value="@phase.Id">@phase.Name</option>
                        }
                    </InputSelect>
                    <button type="button" class="btn btn-primary" @onclick="OnBtnNewPhaseClick">新規</button>
                </div>
                <ValidationMessage For="() => TActual.MPhaseId" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="startdate" class="form-label">開始日時:</label>
                <InputDate Type="InputDateType.DateTimeLocal"
                           id="startdate"
                           @bind-Value="TActual.StartDate"
                           @bind-Value:after="CalculateManHour"
                           class="form-control" />
                <ValidationMessage For="() => TActual.StartDate" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="enddate" class="form-label">終了日時:</label>
                <InputDate Type="InputDateType.DateTimeLocal"
                           id="enddate"
                           @bind-Value="TActual.EndDate"
                           @bind-Value:after="CalculateManHour"
                           class="form-control" />
                <ValidationMessage For="() => TActual.EndDate" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="manhour" class="form-label">作業工数:</label>
                <InputNumber id="manhour" @bind-Value="TActual.ManHour" class="form-control" />
                <ValidationMessage For="() => TActual.ManHour" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">作業内容:</label>
                <InputTextArea id="description" @bind-Value="TActual.Description" class="form-control large-textarea" />
                <ValidationMessage For="() => TActual.Description" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="progressrate" class="form-label">進捗率:</label>
                <div class="input-group">
                    <InputNumber id="progressrate" @bind-Value="TActual.ProgressRate" class="form-control" min="0" max="100" /><span class="input-group-text">%</span>
                </div>
                <ValidationMessage For="() => TActual.ProgressRate" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="remarks" class="form-label">備考:</label>
                <InputText id="remarks" @bind-Value="TActual.Remarks" class="form-control" />
                <ValidationMessage For="() => TActual.Remarks" class="text-danger" />
            </div>
            <InputHidden @bind-Value="TActual.Name" />
            <button type="submit" class="btn btn-primary">登録</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/tplanactuals">一覧に戻る</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }
    /// <summary>
    /// 顧客ID
    /// </summary>
    [SupplyParameterFromQuery]
    private int? MCustomerId { get; set; }
    /// <summary>
    /// プロジェクトID
    /// </summary>
    [SupplyParameterFromQuery]
    private int? MProjectId { get; set; }
    /// <summary>
    /// 工程ID
    /// </summary>
    [SupplyParameterFromQuery]
    private int? MPhaseId { get; set; }
    /// <summary>
    /// 遷移元
    /// </summary>
    [SupplyParameterFromQuery]
    private string? From { get; set; }
    [SupplyParameterFromForm]
    private InputModel? TActual { get; set; }
    private List<MCustomer> Customers = new();
    private List<MProject> Projects = new();
    private List<MPhase> Phases = new();

    /// <summary>
    /// エラーコード
    /// </summary>
    private ErrorCode? ErrorCode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("▽OnInitializedAsync");
        try
        {
            // -----------------------------
            // 初期ロード
            // -----------------------------
            Customers = await DbContext.MCustomer.ToListAsync();
            Projects = await DbContext.MProject.ToListAsync();
            Phases = new();
            TActual ??= new();

            // ユーザー取得
            if (string.IsNullOrEmpty(UserId))
            {
                var users = await UserService.GetUsersAsync();
                UserId = await UserService.GetUserIdAsync(users, UserId!);
            }

            var user = DbContext.Users.FirstOrDefault(u => u.Id == UserId);
            if (user is null)
            {
                ErrorCode = Models.Errors.ErrorCode.NotFound;
                return;
            }

            TActual.UserName = user.FullName;

            var today = DateOnly.FromDateTime(DateTime.Today);

            // 勤務時間
            var startTime = user.MWorkTime?.StartTime ?? new TimeOnly(9, 0);
            var endTime = user.MWorkTime?.EndTime ?? new TimeOnly(18, 0);

            TActual.StartDate = today.ToDateTime(startTime);
            TActual.EndDate = today.ToDateTime(endTime);
            TActual.ManHour = user.MWorkTime?.WorkedDuration?.TotalHours ?? 8;

            // -----------------------------
            // URLパラメータから復元
            // -----------------------------
            MCustomerId ??= 0;
            MProjectId ??= 0;
            MPhaseId ??= 0;

            // Phase がある場合 → Project と Customer を復元
            if (MPhaseId != null && MPhaseId != 0)
            {
                var phase = await DbContext.MPhase
                    .Where(p => p.Id == MPhaseId)
                    .FirstOrDefaultAsync();

                if (phase != null)
                {
                    MProjectId = phase.MProjectId;

                    var project = await DbContext.MProject
                        .Where(p => p.Id == MProjectId)
                        .FirstOrDefaultAsync();

                    if (project != null)
                    {
                        MCustomerId = project.MCustomerId;
                    }
                }
                else
                {
                    MPhaseId = 0;
                }
            }
            else if (MProjectId != null && MProjectId != 0) // Phase がない場合、Project から Customer を復元
            {
                var project = await DbContext.MProject
                    .Where(p => p.Id == MProjectId)
                    .FirstOrDefaultAsync();

                if (project != null)
                {
                    MCustomerId = project.MCustomerId;
                }
            }

            // -----------------------------
            // リスト構築
            // -----------------------------
            Projects = (MCustomerId != null && MCustomerId != 0)
                ? await DbContext.MProject
                    .Where(p => p.MCustomerId == MCustomerId)
                    .OrderBy(p => p.Id)
                    .ToListAsync()
                : await DbContext.MProject
                    .OrderBy(p => p.Id)
                    .ToListAsync();

            Phases = (MProjectId != null && MProjectId != 0)
                ? await DbContext.MPhase
                    .Where(p => p.MProjectId == MProjectId)
                    .OrderBy(p => p.Id)
                    .ToListAsync()
                : new List<MPhase>();

            // TActual に復元（Phase は最後にセットする）
            TActual.MPhaseId = MPhaseId ?? 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△OnInitializedAsync");
    }

    private async Task OnCustomerValueChange()
    {
        if (MCustomerId == null || MCustomerId == 0)
        {
            Projects = await DbContext.MProject.ToListAsync();
            MProjectId = 0;
            Phases = new();
            return;
        }

        Projects = await DbContext.MProject
            .Where(p => p.MCustomerId == MCustomerId)
            .ToListAsync();

        MProjectId = 0;
        Phases = new();
    }

    private async Task OnProjectValueChange()
    {
        if (MProjectId == null || MProjectId == 0)
        {
            Phases = new();
            TActual!.MPhaseId = 0;
            return;
        }

        Phases = await DbContext.MPhase
            .Where(p => p.MProjectId == MProjectId)
            .ToListAsync();

        TActual!.MPhaseId = 0;

        // 顧客も同期
        MCustomerId = await DbContext.MProject
            .Where(p => p.Id == MProjectId)
            .Select(p => p.MCustomerId)
            .FirstOrDefaultAsync();
    }

    /// <summary>
    // 作業工数計算
    /// </summary>
    private async Task CalculateManHour()
    {
        if (TActual is null || UserId is null) return;

        // 作業工数計算
        var duration = await BusinessDayService.CalculateWorkDurationAsync(
            UserId,
            TActual.StartDate,
            TActual.EndDate
        );

        TActual.ManHour = Math.Round(
            duration.TotalHours, 1, MidpointRounding.AwayFromZero);
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddTActual(EditContext context)
    {
        Logger.LogDebug("▽AddTActual");
        try
        {
            if (UserId == null)
            {
                return;
            }
            var project = Projects.FirstOrDefault(p => p.Id == MProjectId)?.Name;
            var phase = Phases.FirstOrDefault(p => p.Id == TActual!.MPhaseId)?.Name;
            TActual!.Name = $"{TActual.StartDate:yyyy/MM/dd} {project} {phase}";
            TActual!.UserId = UserId;

            if (!context.Validate() || TActual!.MPhaseId == 0)
            {
                return;
            }

            ErrorCode = await InputModelService
                .SaveInputModelAsync<InputModel, TActual>(
                    TActual, isCheckDuplicate: false);

            if (ErrorCode == WorkOps.Models.Errors.ErrorCode.None)
            {
                NavigationService.NavigateToBack(From, "tactualid", $"{TActual.Id}",
                        $"tplanactuals?userid={UserId}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred!");
        }
        Logger.LogDebug("△AddTActual");
    }

    private void OnBtnNewCustomerClick(MouseEventArgs args)
    {
        NavigationService.NavigateToCreatet("mcustomers");
    }

    private void OnBtnNewProjectClick(MouseEventArgs args)
    {
        NavigationService.NavigateToCreatet(
            "mprojects", $"mcustomerid={MCustomerId}");
    }

    private void OnBtnNewPhaseClick(MouseEventArgs args)
    {
        NavigationService.NavigateToCreatet(
            "mphases", $"mprojectid={MProjectId}");
    }
}
