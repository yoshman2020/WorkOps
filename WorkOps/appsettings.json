{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.\\workops.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "SiteTitle": "勤怠管理システム",
    "SiteDescription": "勤怠管理、プロジェクト管理を行うシステム",
    "ItemsPerPage": 10,
    "CompanyName": "株式会社〇〇",
    "LoginBufferMin": 15
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Debug", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.ffffff} {Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Microsoft') or StartsWith(SourceContext, 'System')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/app.log",
                  "rollingInterval": "Day",
                  "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.ffffff} {Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Microsoft') or StartsWith(SourceContext, 'System')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/framework.log",
                  "rollingInterval": "Day",
                  "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.ffffff} {Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
